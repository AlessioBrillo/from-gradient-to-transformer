# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Failed local run logs (environment stalls; do not version)
p59_*.log
p59_*.err
# Local de-risk / smoke logs from a local CPU run (not a result: the tracked
# evidence is the manifest, and a local log is written on a dirty tree)
derisk_*.log
run.log

# The local gate's own log (ci-local writes it; the gate's verdict is the
# exit code, the log is scratch)
ci_local_gate.log
exp5_*_figures.log

# Generated figures (regenerated with make reproduce). Anchored to root only —
# an unanchored `figures/` also matched portfolio/figures/, which silently
# swallowed the committed curated set (verified 2026-08-07, Micro-Phase 12 Step 1).
/figures/

# Models and heavy data (do not version large binaries)
*.pt
*.ckpt
*.bin
*.safetensors
07_capstone/data/*
!07_capstone/data/.gitkeep
07_capstone/experiments/*.log

# Rolling resume checkpoints + heartbeat/launch logs (runtime state)
checkpoints/

# Obsidian (local cache, do not share)
.obsidian/workspace*
.obsidian/cache
.claude/

# Temporary alignment papers (do not version)
from-gradient-to-transformer-PhD.md
refactor.md
paper.md

# Quick-mode manifests: `--quick` is a reduced config, not the canonical run,
# so src/results.py routes it to results/probe_<experiment>_quick.json instead
# of the tracked results/<experiment>.json. Scratch by design.
results/probe_*_quick.json

# Scratch manifests of a figure-regeneration run: the tracked manifest is the
# evidence, the scratch one exists only so the run cannot overwrite it.
results/scratch_*.json

# Remote-run staging: rendered Kaggle kernels and downloaded manifests wait
# here until pin_remote_run.py validates and installs them into results/.
# Scratch by design — nothing under it is a claim until it is pinned.
results/remote/

# CI / Coverage
.coverage
.coverage.*
htmlcov/

# Tooling temporary files
compass_artifact_wf-*.md

# OS
.DS_Store
src/from_gradient_to_transformer.egg-info/

_site/
